# .env.example — copy to .env and fill in. The real .env is gitignored (never commit secrets).
# Loaded by scripts at runtime (fetch_alpaca.py auto-loads the repo .env if the vars
# are not already exported in the shell environment).

# ── Alpaca API (paper) ────────────────────────────────────────────────────
# Same credentials work for the trading API and the public data API.
# Get keys: https://dashboard.alpaca.markets -> API Keys. Data endpoint:
#   GET https://data.alpaca.markets/v2/stocks/{symbol}/bars
# Paper trading endpoint: https://paper-api.alpaca.markets
ALPACA_API_KEY_ID=PK...
ALPACA_API_SECRET_KEY=SEKRED...
# Short aliases (optional if you prefer the short names):
ALPACA_KEY=
ALPACA_SECRET=
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.venv/
venv/
.venv/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/


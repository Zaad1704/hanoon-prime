runtime/
logs/
*.log
*.pid
*.lock
data/market_data/

# Environment secrets (ALWAYS gitignored — contains API keys)
.env
.env.local
*.pem

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Static analysis caches
.mypy_cache/
.ruff_cache/
